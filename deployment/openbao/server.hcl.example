ui = true
api_addr = "https://bao.example.com:8200"
cluster_addr = "https://bao.example.com:8201"
storage "raft" {
  path = "/bao/data"
  node_id = "tsma-vault-1"
}
listener "tcp" {
  address = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_cert_file = "/bao/tls/server.crt"
  tls_key_file = "/bao/tls/server.key"
  tls_min_version = "tls12"
}
plugin_directory = "/bao/plugins"
plugin_auto_download = true
plugin_auto_register = true
plugin "secret" "ldap" {
  image = "ghcr.io/openbao/openbao-plugin-secrets-ldap:v0.1.0@sha256:21b4abe634d885cd7273805742b38d031474c2374ec7d69ddb8c4c7eb6e26b5e"
}

audit "file" "file" {
  description = "TSMA audit log"
  options {
    file_path = "/bao/audit/audit.json"
  }
}
